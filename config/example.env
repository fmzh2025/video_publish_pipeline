# GitHub repository
GITHUB_OWNER=fmzh2025
GITHUB_REPO=MoneyPrinterTurbo
GITHUB_WORKFLOW=generate-video.yml
GITHUB_REF=main

# Token used by the trigger API to dispatch workflow runs and by the worker to download artifacts.
# Required permissions:
# - workflow dispatch: Actions write
# - artifact download: Actions read
GITHUB_TOKEN=

# Optional local-only env file used by launchd wrappers. Do not commit it:
# /Volumes/T7/project/project_fmzh/2026/video_publish_pipeline/config/local.env

# Notification channel: redis, callback, or both.
MPT_NOTIFY_CHANNEL=callback

# API Callback server on the current server.
MPT_CALLBACK_HOST=0.0.0.0
MPT_CALLBACK_PORT=8088
MPT_CALLBACK_PATH=/api/mpt/video/workflow-callback
MPT_CALLBACK_TOKEN=

# Callback URL configured in MoneyPrinterTurbo GitHub Actions secrets.
# Example: https://example.com/api/mpt/video/workflow-callback
MPT_CALLBACK_URL=

# Upstash Redis. Required when MPT_NOTIFY_CHANNEL is redis or both.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MPT_STREAM_KEY=mpt:video:events
MPT_CONSUMER_GROUP=mpt-video-workers

# Local paths
PIPELINE_ROOT=/Volumes/T7/project/project_fmzh/2026/video_publish_pipeline
WORKDIR=/Volumes/T7/project/project_fmzh/2026/video_publish_pipeline/workdir
AUTO_PUBLISH_DIR=/Users/fumingzhen/project/auto_publish

# Toutiao publish behavior
TOUTIAO_PUBLISH=true
TOUTIAO_WAIT_LOGIN_MS=300000
TOUTIAO_UPLOAD_TIMEOUT_MS=1800000
TOUTIAO_PROCESS_TIMEOUT_MS=1800000
TOUTIAO_KEEP_OPEN=false
